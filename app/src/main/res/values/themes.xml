<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SmartCalculator" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.SmartCalculator" parent="Base.Theme.SmartCalculator" />


    <style name="CalcBtnBase" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>

        <item name="android:layout_margin">1dp</item>

        <item name="cornerRadius">0dp</item> <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="GrayButton" parent="CalcBtnBase">
        <item name="backgroundTint">#3D3D3D</item>
        <item name="android:textColor">#4CAF50</item>
    </style>

    <style name="BlackButton" parent="CalcBtnBase">
        <item name="backgroundTint">#252525</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="OrangeButton" parent="CalcBtnBase">
        <item name="backgroundTint">#F44336</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

</resources>